
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopEasy - Online Shopping</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f5f6fa;
            color: #222;
        }

        /* Header */
        header {
            background: #172337;
            color: white;
            padding: 18px 6%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .logo {
            font-size: 27px;
            font-weight: bold;
            color: #ffcc00;
        }

        .search-box {
            display: flex;
            flex: 1;
            max-width: 450px;
        }

        .search-box input {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 5px 0 0 5px;
            outline: none;
        }

        .search-box button {
            padding: 12px 18px;
            background: #ffcc00;
            border: none;
            cursor: pointer;
            border-radius: 0 5px 5px 0;
        }

        .cart-button {
            background: #ffcc00;
            border: none;
            padding: 12px 18px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }

        /* Navigation */
        nav {
            background: white;
            padding: 15px;
            text-align: center;
            box-shadow: 0 2px 5px #ddd;
        }

        nav a {
            text-decoration: none;
            color: #172337;
            margin: 0 18px;
            font-weight: bold;
        }

        /* Hero section */
        .hero {
            background: linear-gradient(120deg, #172337, #38598b);
            color: white;
            padding: 65px 8%;
            text-align: center;
        }

        .hero h1 {
            font-size: 40px;
            margin-bottom: 15px;
        }

        .hero p {
            margin-bottom: 25px;
            font-size: 18px;
        }

        .hero button {
            background: #ffcc00;
            padding: 14px 28px;
            border: none;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
        }

        /* Products */
        .container {
            padding: 35px 6%;
        }

        .section-title {
            text-align: center;
            margin-bottom: 25px;
            font-size: 30px;
        }

        .filters {
            display: flex;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 30px;
        }

        .filters button {
            padding: 10px 18px;
            border: 1px solid #172337;
            background: white;
            border-radius: 20px;
            cursor: pointer;
        }

        .filters button.active,
        .filters button:hover {
            background: #172337;
            color: white;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 25px;
        }

        .product-card {
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 3px 12px #ddd;
            transition: transform 0.2s;
        }

        .product-card:hover {
            transform: translateY(-5px);
        }

        .product-card img {
            width: 100%;
            height: 210px;
            object-fit: contain;
            padding: 15px;
            background: white;
        }

        .product-info {
            padding: 18px;
        }

        .product-info h3 {
            margin-bottom: 10px;
        }

        .price {
            color: #16803c;
            font-size: 21px;
            font-weight: bold;
            margin-bottom: 12px;
        }

        .product-info button {
            width: 100%;
            padding: 12px;
            background: #ffcc00;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }

        .product-info button:hover {
            background: #f0b900;
        }

        /* Cart */
        .cart-section {
            background: white;
            margin: 20px 6% 40px;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 10px #ddd;
        }

        .cart-section h2 {
            margin-bottom: 20px;
        }

        .cart-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 15px 0;
            border-bottom: 1px solid #ddd;
        }

        .quantity-controls button,
        .remove-button {
            padding: 6px 10px;
            margin: 0 3px;
            cursor: pointer;
        }

        .remove-button {
            background: #e74c3c;
            color: white;
            border: none;
            border-radius: 4px;
        }

        .cart-total {
            text-align: right;
            font-size: 23px;
            font-weight: bold;
            margin-top: 20px;
        }

        .checkout-button {
            display: block;
            margin: 20px 0 0 auto;
            padding: 13px 25px;
            background: #16803c;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        /* Footer */
        footer {
            background: #172337;
            color: white;
            text-align: center;
            padding: 25px;
        }

        @media (max-width: 600px) {
            header {
                justify-content: center;
            }

            .search-box {
                order: 3;
                flex-basis: 100%;
            }

            .hero h1 {
                font-size: 30px;
            }

            nav a {
                display: inline-block;
                margin: 8px;
            }

            .cart-item {
                flex-wrap: wrap;
            }
        }
    </style>
</head>

<body>

    <header>
        <div class="logo">ShopEasy</div>

        <div class="search-box">
            <input
                type="text"
                id="searchInput"
                placeholder="Search products..."
                aria-label="Search products"
            >
            <button onclick="renderProducts()">Search</button>
        </div>

        <button class="cart-button" onclick="showCart()">
            🛒 Cart (<span id="cartCount">0</span>)
        </button>
    </header>

    <nav>
        <a href="#">Home</a>
        <a href="#products">Products</a>
        <a href="#cart">Shopping Cart</a>
        <a href="#footer">Contact</a>
    </nav>

    <section class="hero">
        <h1>Welcome to ShopEasy!</h1>
        <p>Discover amazing products at great prices.</p>
        <button onclick="document.getElementById('products')
            .scrollIntoView({behavior:'smooth'})">
            Shop Now
        </button>
    </section>

    <main class="container" id="products">
        <h2 class="section-title">Our Products</h2>

        <div class="filters">
            <button class="active" data-category="All">All</button>
            <button data-category="Electronics">Electronics</button>
            <button data-category="Fashion">Fashion</button>
            <button data-category="Accessories">Accessories</button>
        </div>

        <div class="product-grid" id="productGrid"></div>
        <p id="emptyMessage" hidden style="text-align:center; margin:25px">
            No products found.
        </p>
    </main>

    <section class="cart-section" id="cart">
        <h2>🛒 Your Shopping Cart</h2>
        <div id="cartItems">Your cart is empty.</div>
        <div class="cart-total">
            Total: ₹<span id="cartTotal">0</span>
        </div>
        <button class="checkout-button" onclick="checkout()">
            Proceed to Checkout
        </button>
    </section>

    <footer id="footer">
        <p>© 2026 ShopEasy. All rights reserved.</p>
        <p style="margin-top:10px">
            Email: support@shopeasy.example
        </p>
    </footer>

    <script>
        const products = [
            {
                id: 1,
                name: "Wireless Headphones",
                price: 1499,
                category: "Electronics",
                image: "https://placehold.co/300x220/e8eef7/172337?text=Headphones"
            },
            {
                id: 2,
                name: "Smart Watch",
                price: 2299,
                category: "Electronics",
                image: "https://placehold.co/300x220/e8eef7/172337?text=Smart+Watch"
            },
            {
                id: 3,
                name: "Running Shoes",
                price: 1899,
                category: "Fashion",
                image: "https://placehold.co/300x220/f5e8dc/172337?text=Shoes"
            },
            {
                id: 4,
                name: "Casual T-Shirt",
                price: 599,
                category: "Fashion",
                image: "https://placehold.co/300x220/f5e8dc/172337?text=T-Shirt"
            },
            {
                id: 5,
                name: "Travel Backpack",
                price: 999,
                category: "Accessories",
                image: "https://placehold.co/300x220/e4efe7/172337?text=Backpack"
            },
            {
                id: 6,
                name: "Sunglasses",
                price: 799,
                category: "Accessories",
                image: "https://placehold.co/300x220/e4efe7/172337?text=Sunglasses"
            }
        ];

        let cart = [];
        let selectedCategory = "All";

        function renderProducts() {
            const grid = document.getElementById("productGrid");
            const search = document.getElementById("searchInput")
                .value.trim().toLowerCase();

            const filtered = products.filter(product =>
                (selectedCategory === "All" ||
                 product.category === selectedCategory) &&
                product.name.toLowerCase().includes(search)
            );

            grid.innerHTML = filtered.map(product => `
                <article class="product-card">
                    <img src="${product.image}"
                         alt="${product.name}"
                         loading="lazy">
                    <div class="product-info">
                        <h3>${product.name}</h3>
                        <p>${product.category}</p>
                        <p class="price">₹${product.price.toLocaleString("en-IN")}</p>
                        <button onclick="addToCart(${product.id})">
                            Add to Cart
                        </button>
                    </div>
                </article>
            `).join("");

            document.getElementById("emptyMessage").hidden =
                filtered.length !== 0;
        }

        function addToCart(id) {
            const product = products.find(item => item.id === id);
            const existing = cart.find(item => item.id === id);

            if (existing) {
                existing.quantity++;
            } else {
                cart.push({...product, quantity: 1});
            }

            updateCart();
        }

        function changeQuantity(id, amount) {
            const item = cart.find(product => product.id === id);
            if (!item) return;

            item.quantity += amount;

            if (item.quantity <= 0) {
                cart = cart.filter(product => product.id !== id);
            }

            updateCart();
        }

        function removeFromCart(id) {
            cart = cart.filter(product => product.id !== id);
            updateCart();
        }

        function updateCart() {
            const cartItems = document.getElementById("cartItems");

            document.getElementById("cartCount").textContent =
                cart.reduce((sum, item) => sum + item.quantity, 0);

            if (cart.length === 0) {
                cartItems.textContent = "Your cart is empty.";
            } else {
                cartItems.innerHTML = cart.map(item => `
                    <div class="cart-item">
                        <div>
                            <strong>${item.name}</strong><br>
                            ₹${item.price.toLocaleString("en-IN")} each
                        </div>
                        <div class="quantity-controls">
                            <button onclick="changeQuantity(${item.id}, -1)"
                                    aria-label="Decrease quantity">−</button>
                            ${item.quantity}
                            <button onclick="changeQuantity(${item.id}, 1)"
                                    aria-label="Increase quantity">+</button>
                        </div>
                        <strong>₹${(item.price * item.quantity)
                            .toLocaleString("en-IN")}</strong>
                        <button class="remove-button"
                                onclick="removeFromCart(${item.id})">
                            Remove
                        </button>
                    </div>
                `).join("");
            }

            const total = cart.reduce(
                (sum, item) => sum + item.price * item.quantity, 0
            );

            document.getElementById("cartTotal").textContent =
                total.toLocaleString("en-IN");
        }

        function showCart() {
            document.getElementById("cart").scrollIntoView({
                behavior: "smooth"
            });
        }

        function checkout() {
            if (cart.length === 0) {
                alert("Your shopping cart is empty!");
                return;
            }

            alert("This is a demo store. Connect a backend and payment gateway to accept real orders.");
        }

        document.querySelectorAll(".filters button").forEach(button => {
            button.addEventListener("click", () => {
                selectedCategory = button.dataset.category;

                document.querySelectorAll(".filters button")
                    .forEach(item => item.classList.remove("active"));

                button.classList.add("active");
                renderProducts();
            });
        });

        document.getElementById("searchInput")
            .addEventListener("input", renderProducts);

        renderProducts();
        updateCart();
    </script>

</body>
</html>
